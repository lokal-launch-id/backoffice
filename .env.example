VITE_API_BASE_URL=http://localhost:8080
VITE_DEV_MOCK_API=false
VITE_DEV_API_DELAY=10
VITE_ENABLE_DEBUG=true

# Cloudflare Turnstile site key (public). Pairs with the backend TURNSTILE_SECRET_KEY.
# Leave EMPTY where CAPTCHA is disabled (e.g. staging); set the real widget key
# on prod. The widget only renders when this is set.
VITE_TURNSTILE_SITE_KEY=
